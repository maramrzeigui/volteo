APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Serveur OCPP (ocpp-server/) : secret partagé obligatoire en production
OCPP_SERVER_URL=http://127.0.0.1:9221
OCPP_SHARED_SECRET=
OCPP_URL_PUBLIQUE=ws://127.0.0.1:9220/ocpp
OCPP_EXIGER_MOT_DE_PASSE=true
OCPP_INTERVALLE_HEARTBEAT=30
# Paiement en ligne (Tunisie). « test » : page de paiement locale avec cartes de test,
# utilisée tant qu'aucune passerelle n'est configurée (jamais en production).
PAIEMENT_MODE=test
# ClicToPay (SMT) — cartes CIB / Visa / Mastercard. Accès fournis par la banque.
CLICTOPAY_IDENTIFIANT=
CLICTOPAY_MOT_DE_PASSE=
CLICTOPAY_URL=https://test.clictopay.com/payment/rest/
# Flouci — portefeuille Flouci + cartes bancaires (developers.flouci.com).
FLOUCI_CLE_PUBLIQUE=
FLOUCI_CLE_PRIVEE=
# Konnect — carte bancaire et e-DINAR (konnect.network).
KONNECT_CLE_API=
KONNECT_PORTEFEUILLE=
KONNECT_PRODUCTION=false
PAIEMENT_RETOUR_WEB=http://localhost:5273/espace/paiements
PAIEMENT_RETOUR_MOBILE=borneapp://paiement

# Assistant IA « Volta » (Claude) : sans clé, l'assistant est désactivé proprement (503)
ANTHROPIC_API_KEY=
ASSISTANT_MODELE=claude-opus-5-5
ASSISTANT_EFFORT=medium
ASSISTANT_QUESTIONS_GRATUITES=10

# Connexion Google : identifiants client OAuth (iOS, Android, Web) séparés par des virgules
GOOGLE_CLIENT_IDS=

# Connexion Google : identifiant client OAuth « Application Web » (site) ; iOS/Android dans GOOGLE_CLIENT_IDS.
GOOGLE_WEB_CLIENT_ID=

# Assistant Volta : « ollama » (local, gratuit) ou « claude » (API Anthropic + ANTHROPIC_API_KEY).
ASSISTANT_MOTEUR=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELE=qwen2.5:7b

# Volteo Chain (blockchain/) : vide = désactivé. En local : http://127.0.0.1:9400
BLOCKCHAIN_PONT_URL=
BLOCKCHAIN_PONT_SECRET=secret-blockchain-dev
